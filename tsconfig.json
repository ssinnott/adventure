{
  // Type checking only; esbuild does all emitting. Same arrangement as game-engine (see its
  // tsconfig.json for the reasoning behind `noEmit` + `allowImportingTsExtensions` + '.ts' specifiers).
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "tools/**/*.ts", "types/**/*.d.ts"]
}
